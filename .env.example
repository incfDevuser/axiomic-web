# Copy to .env.local and fill in.

# Public URL of the site (used for metadata, OG images, sitemap).
NEXT_PUBLIC_SITE_URL=https://axiomic.cl

# Contact form: pilot requests are emailed through Resend (https://resend.com).
RESEND_API_KEY=
# Sender must be on a domain verified in Resend, e.g. "Axiomic <piloto@axiomic.cl>".
CONTACT_FROM_EMAIL=
# Where pilot requests land. Defaults to hola@axiomic.cl.
CONTACT_TO_EMAIL=

# Optional: scheduling link shown under the form (Cal.com, Calendly…).
NEXT_PUBLIC_BOOKING_URL=
